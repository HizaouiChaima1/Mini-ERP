@echo off\nREM ===================================\nREM Script de démarrage RMI - Mini-ERP\nREM ===================================\nREM \nREM Ce script facilite le démarrage du projet avec Java RMI activé sur Windows\nREM \nREM Usage: start-with-rmi.bat [docker|local|stop|clean|logs]\nREM\n\nsetlocal enabledelayedexpansion\n\necho.\necho ====================================================================\necho              Mini-ERP - Java RMI Startup Script (Windows)\necho ====================================================================\necho.\n\nif \"%1\"==\"\" (\n    REM Par défaut, lancer avec Docker\n    call :start_docker\n) else if \"%1\"==\"docker\" (\n    call :start_docker\n) else if \"%1\"==\"local\" (\n    call :start_local\n) else if \"%1\"==\"stop\" (\n    call :stop_services\n) else if \"%1\"==\"clean\" (\n    call :clean_build\n) else if \"%1\"==\"logs\" (\n    call :show_logs\n) else (\n    echo ❌ Option inconnue: %1\n    echo.\n    call :show_help\n    exit /b 1\n)\n\ngoto :end\n\nREM Fonction pour afficher l'aide\n:show_help\necho Usage: start-with-rmi.bat [docker^|local^|stop^|clean^|logs]\necho.\necho Options:\necho   docker   - Lancer avec Docker Compose (par défaut)\necho   local    - Lancer localement\necho   stop     - Arrêter les services\necho   clean    - Nettoyer et reconstruire\necho   logs     - Afficher les logs\necho.\ngoto :eof\n\nREM Fonction pour lancer avec Docker Compose\n:start_docker\necho 🐳 Lancement avec Docker Compose...\necho.\n\necho 📦 Construction du module RMI commun...\nif exist \"rmi-common\" (\n    cd rmi-common\n    call mvn clean install -q\n    cd ..\n    echo ✅ Module RMI commun construit avec succès\n) else (\n    echo ⚠️  Module rmi-common non trouvé\n)\n\necho.\necho 🚀 Lancement des services...\ncall docker-compose up -d\n\necho.\necho ⏳ Attendre que les services démarrent (30 secondes)...\ntimeout /t 30 /nobreak\n\necho.\necho ====================================================================\necho ✅ Services démarrés avec succès!\necho ====================================================================\necho.\necho 📍 Points d'accès:\necho    • Frontend         : http://localhost:3000\necho    • API Gateway      : http://localhost:8080\necho    • Stock Service    : http://localhost:8081\necho    • Ventes Service   : http://localhost:8082\necho    • Finance Service  : http://localhost:8083\necho.\necho 📡 Services RMI:\necho    • Stock Service RMI    : rmi://localhost:1099/StockService\necho    • Ventes Service RMI   : rmi://localhost:1100/VentesService\necho    • Finance Service RMI  : rmi://localhost:1101/FinanceService\necho.\necho 📊 RabbitMQ:\necho    • Management UI : http://localhost:15672 (guest/guest)\necho.\necho 📖 Documentation:\necho    • Guide RMI             : ./RMI_GUIDE.md\necho    • Résumé modifications  : ./RMI_MODIFICATIONS_SUMMARY.md\necho    • Rapport architecture  : ./RAPPORT_ARCHITECTURE.md\necho.\necho 💡 Commandes utiles:\necho    • Voir les logs      : docker-compose logs -f\necho    • Arrêter services   : docker-compose down\necho    • Nettoyer volumes   : docker-compose down -v\necho.\ngoto :eof\n\nREM Fonction pour lancer localement\n:start_local\necho 💻 Lancement en local...\necho.\n\necho 📦 Construction du module RMI commun...\nif exist \"rmi-common\" (\n    cd rmi-common\n    call mvn clean install -q\n    cd ..\n    echo ✅ Module RMI commun construit\n) else (\n    echo ⚠️  Module rmi-common non trouvé\n    exit /b 1\n)\n\necho.\necho 🚀 Lancement des services (dans des cmd séparés)...\necho.\n\necho 📦 Démarrage Stock Service (port 8081, RMI 1099)...\ncd stock-service\nstart \"Stock Service\" cmd /k \"mvn clean spring-boot:run\"\ncd ..\n\ntimeout /t 5 /nobreak\n\necho 📦 Démarrage Ventes Service (port 8082, RMI 1100)...\ncd ventes-service\nstart \"Ventes Service\" cmd /k \"mvn clean spring-boot:run\"\ncd ..\n\ntimeout /t 5 /nobreak\n\necho 📦 Démarrage Finance Service (port 8083, RMI 1101)...\ncd finance-service\nstart \"Finance Service\" cmd /k \"mvn clean spring-boot:run\"\ncd ..\n\ntimeout /t 5 /nobreak\n\necho 📦 Démarrage API Gateway (port 8080)...\ncd api-gateway\nstart \"API Gateway\" cmd /k \"mvn clean spring-boot:run\"\ncd ..\n\necho.\necho ====================================================================\necho ✅ Services démarrés en local!\necho ====================================================================\necho.\necho Services lancés dans des fenêtres de commande séparées\necho.\necho 📍 Points d'accès:\necho    • Frontend         : http://localhost:3000\necho    • API Gateway      : http://localhost:8080\necho.\necho Fermer les fenêtres de commande pour arrêter les services\necho.\ngoto :eof\n\nREM Fonction pour arrêter les services\n:stop_services\necho ⏹️  Arrêt des services...\necho.\ncall docker-compose down\necho ✅ Services arrêtés\ngoto :eof\n\nREM Fonction pour nettoyer et reconstruire\n:clean_build\necho 🧹 Nettoyage et reconstruction...\necho.\n\nif exist \"rmi-common\" (\n    cd rmi-common\n    call mvn clean\n    cd ..\n)\n\nfor %%s in (stock-service ventes-service finance-service api-gateway) do (\n    if exist \"%%s\" (\n        cd \"%%s\"\n        call mvn clean\n        cd ..\n    )\n)\n\necho ✅ Nettoyage terminé\necho.\necho Relancer avec: start-with-rmi.bat docker\ngoto :eof\n\nREM Fonction pour afficher les logs\n:show_logs\necho 📋 Affichage des logs...\necho.\ncall docker-compose logs -f\ngoto :eof\n\n:end\nendlocal\n"